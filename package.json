{
  "name": "pair-mode",
  "version": "0.1.0",
  "description": "Annotate a coding agent's proposed edits line by line, in your terminal.",
  "type": "module",
  "license": "MIT",
  "bin": { "pair-mode": "dist/cli.js" },
  "files": ["dist", "assets", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "capture": "node scripts/capture-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
